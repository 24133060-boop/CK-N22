<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Quản lý voucher</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4"><a href="/manager">← Tổng quan</a><h2>Quản lý voucher</h2><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
<form method="post" action="/manager/vouchers" class="card p-3 mb-3 row g-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Mã voucher<input class="form-control" name="code" pattern="[A-Za-z0-9_-]{3,40}" required></label><label>Giảm (%)<input class="form-control" type="number" name="percent" min="1" max="100" step="1" required></label><label>Giá trị tối thiểu (đ)<input class="form-control" type="number" name="minSubtotal" value="0" min="0" required></label><label>Giảm tối đa (đ)<input class="form-control" type="number" name="maxDiscount" min="1" required></label><label>Ngày hết hạn (không bắt buộc)<input class="form-control" type="date" name="expiresOn"></label><button class="btn btn-success">Tạo mã</button></form>
<table class="table table-striped"><thead><tr><th>Mã</th><th>Giảm</th><th>Đơn tối thiểu</th><th>Tối đa</th><th>Hạn</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="v" items="${vouchers}"><tr><td><c:out value="${v.code}"/></td><td>${v.percent}%</td><td>${v.minSubtotal}đ</td><td>${v.maxDiscount}đ</td><td>${v.expiresOn}</td><td><form method="post" action="/manager/vouchers/${v.id}/toggle"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-primary">${v.active ? 'Đang bật' : 'Đang tắt'} — Đổi</button></form></td></tr></c:forEach></tbody></table></main></body></html>