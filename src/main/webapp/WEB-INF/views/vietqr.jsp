<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thanh toán VietQR - UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-5" style="max-width:720px"><a href="/my-orders">← Đơn hàng của tôi</a><h2 class="mt-3">Chuyển khoản VietQR - Đơn #${order.id}</h2>
<c:choose><c:when test="${order.paymentStatus eq 'PAID'}"><div class="alert alert-success">Đơn đã được xác nhận thanh toán.</div></c:when><c:when test="${order.status eq 'CANCELLED'}"><div class="alert alert-warning">Đơn đã hủy, không chuyển khoản.</div></c:when><c:when test="${not configured}"><div class="alert alert-danger">Chưa cấu hình tài khoản nhận VietQR. Vui lòng liên hệ cửa hàng.</div></c:when><c:otherwise><div class="card p-4 text-center"><p>Quét QR bằng ứng dụng ngân hàng để chuyển khoản <strong>${order.total} VND</strong></p><img src="${qrUrl}" alt="VietQR chuyển khoản" style="max-width:320px;width:100%;margin:auto" referrerpolicy="no-referrer"><hr><p>Ngân hàng: <strong>Vietcombank (${bank})</strong></p><p>Chủ tài khoản: <strong><c:out value="${accountName}"/></strong></p><p>Số tài khoản: <strong><c:out value="${account}"/></strong></p><p>Nội dung: <strong><c:out value="${transferContent}"/></strong></p><div class="alert alert-warning">VietQR không tự xác nhận đã nhận tiền. Chỉ Vendor/Manager được đánh dấu đã thanh toán sau khi đối chiếu sao kê. Không chuyển khoản lần hai nếu đã thanh toán.</div></div></c:otherwise></c:choose><a class="btn btn-outline-primary mt-3" href="/my-orders/${order.id}/detail">Xem chi tiết đơn</a></main></body></html>
