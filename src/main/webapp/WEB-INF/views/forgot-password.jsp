<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khôi phục mật khẩu - UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-5" style="max-width:560px"><a href="/login">← Đăng nhập</a><h2 class="my-4">Khôi phục mật khẩu</h2><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
<section class="card p-4 mb-4"><h5>Bước 1: Nhận mã OTP</h5><form method="post" action="/forgot-password"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="email" name="email" class="form-control mb-3" placeholder="Email tài khoản" required><button class="btn btn-primary">Gửi OTP</button></form></section>
<section class="card p-4"><h5>Bước 2: Đặt mật khẩu mới</h5><form method="post" action="/reset-password"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="email" name="email" class="form-control mb-3" placeholder="Email tài khoản" required><input name="otp" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="Mã OTP 6 chữ số" required><input type="password" name="password" class="form-control mb-3" minlength="8" maxlength="72" placeholder="Mật khẩu mới" required><button class="btn btn-success">Đổi mật khẩu</button></form></section></main></body></html>