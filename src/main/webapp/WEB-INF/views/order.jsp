<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><div class="row justify-content-center"><div class="col-md-7"><h2>Tuỳ chỉnh món uống</h2><form method="post" action="/favorites/${product.id}/toggle" class="mb-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-danger btn-sm" type="submit">♡ Thêm / bỏ yêu thích</button> <a class="btn btn-outline-success btn-sm" href="/favorites">Danh sách yêu thích</a></form><div class="card p-4"><h4><c:out value="${product.name}"/></h4><p class="text-success fw-bold"><span id="drinkUnitPrice">${product.price}</span> đ / ly <span class="small text-muted">(đã gồm size và topping)</span></p><div class="alert alert-light border">🏪 Chi nhánh cung cấp: <strong><c:out value="${product.shop.name}"/></strong><div class="small text-muted">Để đổi chi nhánh, quay về danh sách cửa hàng và chọn món tại chi nhánh khác.</div><a href="/shop/${product.shop.id}" class="small">Xem menu chi nhánh</a></div><form action="/order" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="productId" value="${product.id}"><div class="row g-3"><div class="col-6"><label>Size</label><select name="size" id="drinkSize" class="form-select"><option value="S">S (giá gốc)</option><option value="M" selected>M (+5.000đ)</option><option value="L">L (+10.000đ)</option></select></div><div class="col-6"><label>Đường</label><select name="sugar" class="form-select"><option>0%</option><option>30%</option><option selected>50%</option><option>100%</option></select></div><div class="col-6"><label>Đá</label><select name="ice" class="form-select"><option>0%</option><option selected>50%</option><option>100%</option></select></div><div class="col-6"><label>Topping</label><select name="topping" id="drinkTopping" class="form-select"><option value="Không">Không (+0đ)</option><option value="Trân châu đen">Trân châu đen (+5.000đ)</option><option value="Trân châu trắng">Trân châu trắng (+6.000đ)</option><option value="Thạch dừa">Thạch dừa (+5.000đ)</option><option value="Pudding trứng">Pudding trứng (+7.000đ)</option><option value="Kem cheese">Kem cheese (+10.000đ)</option></select></div><div class="col-6"><label>Số lượng</label><input class="form-control" type="number" min="1" max="30" value="1" name="quantity"></div><div class="col-6"><label>Nhận hàng</label><select class="form-select" name="fulfillment"><option value="DELIVERY" disabled>Giao hàng (chọn qua giỏ hàng có bản đồ)</option><option value="PICKUP">Nhận tại cửa hàng</option></select></div><div class="col-12"><label>Địa chỉ (nếu giao hàng)</label><input class="form-control" name="address" maxlength="250"></div></div><p class="mt-3 mb-0 fw-semibold">Tổng tiền món: <span id="drinkTotal"></span></p><button class="btn btn-primary mt-4 w-100">Đặt hàng COD ngay</button><button class="btn btn-outline-success mt-2 w-100" type="submit" formaction="/cart/add">Thêm vào giỏ hàng</button></form></div></div></div><section class="mt-4" id="productReviews"><h4>Đánh giá sản phẩm</h4><p class="text-muted small">Chỉ khách đã mua món này trong đơn hoàn thành mới được đánh giá.</p><form method="post" action="/products/${product.id}/review" enctype="multipart/form-data" class="card p-3 mb-3"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label class="form-label">Số sao</label><select class="form-select mb-2" name="rating"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select><textarea name="comment" minlength="50" maxlength="500" required class="form-control mb-2" placeholder="Nhận xét (từ 50 đến 500 ký tự)"></textarea><label class="form-label">Ảnh hoặc video đánh giá (JPG/PNG/WebP/MP4, tối đa 15MB)</label><input type="file" name="media" accept="image/jpeg,image/png,image/webp,video/mp4" class="form-control mb-2"><button class="btn btn-success">Gửi đánh giá</button></form><c:choose><c:when test="${empty reviews}"><p class="text-muted">Chưa có đánh giá nào.</p></c:when><c:otherwise><c:forEach var="r" items="${reviews}"><div class="card p-3 mb-2"><strong><c:out value="${r.user.displayName}"/> · ${r.rating}/5 sao</strong><p class="mb-0"><c:out value="${r.comment}"/></p><c:if test="${not empty r.mediaUrl}"><c:choose><c:when test="${r.mediaType eq 'VIDEO'}"><video class="mt-2" controls style="max-width:320px;width:100%" src="${r.mediaUrl}"></video></c:when><c:otherwise><img class="mt-2 rounded" style="max-width:320px;width:100%" src="${r.mediaUrl}" alt="Ảnh đánh giá"></c:otherwise></c:choose></c:if></div></c:forEach></c:otherwise></c:choose></section></main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>(function(){
const size=document.getElementById('drinkSize'),top=document.getElementById('drinkTopping'),qty=document.querySelector('input[name="quantity"]');
const base=Number('${product.price}');
const s={S:0,M:5000,L:10000},t={'Không':0,'Trân châu đen':5000,'Trân châu trắng':6000,'Thạch dừa':5000,'Pudding trứng':7000,'Kem cheese':10000};
function update(){const unit=base+s[size.value]+t[top.value];document.getElementById('drinkUnitPrice').textContent=unit.toLocaleString('vi-VN');document.getElementById('drinkTotal').textContent=(unit*Number(qty.value||1)).toLocaleString('vi-VN')+'đ';}
[size,top,qty].forEach(el=>el.addEventListener('change',update));qty.addEventListener('input',update);update();
})();</script></body></html>
