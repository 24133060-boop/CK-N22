<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><h2>Đơn hàng của tôi</h2>
<div class="row g-2 mb-3"><div class="col-md-5"><label class="form-label small">Lọc trạng thái</label><select id="orderStatusFilter" class="form-select"><option value="">Tất cả trạng thái</option><option value="NEW">Chờ xác nhận</option><option value="CONFIRMED">Đã xác nhận</option><option value="PREPARING">Đang chuẩn bị</option><option value="READY">Sẵn sàng</option><option value="ASSIGNED">Đã phân công giao</option><option value="SHIPPING">Đang giao</option><option value="DELIVERED">Đã hoàn thành</option><option value="CANCELLED">Đã hủy</option></select></div><div class="col-md-5"><label class="form-label small">Tìm theo mã đơn hoặc chi nhánh</label><input id="orderSearch" class="form-control" placeholder="Ví dụ: 12, Thủ Đức"></div></div>
<c:if test="${empty orders}"><div class="alert alert-light border">Bạn chưa có đơn hàng nào. <a href="/#menu">Xem menu</a></div></c:if>
<div id="ordersNoMatch" class="alert alert-light border d-none">Không có đơn hàng phù hợp bộ lọc.</div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Mã</th><th>Món</th><th>Cửa hàng</th><th>Số lượng</th><th>Tổng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr class="order-row" data-status="${o.status}" data-search="#${o.id} ${o.shop.name}"><td><a href="/my-orders/${o.id}/detail">#${o.id}</a></td><td><c:out value="${o.productName}"/><c:if test="${not empty o.lines}"><details class="small mt-1"><summary>Chi tiết ${o.lines.size()} món</summary><c:forEach var="line" items="${o.lines}"><div><c:out value="${line.productName}"/> × ${line.quantity} — <c:out value="${line.size}"/> / <c:out value="${line.sugar}"/> / <c:out value="${line.ice}"/> / <c:out value="${line.topping}"/></div></c:forEach></details></c:if></td><td><c:out value="${o.shop.name}"/></td><td>${o.quantity}</td><td>${o.total} đ<c:if test="${o.fulfillment eq 'DELIVERY'}"><div class="small text-muted"><c:choose><c:when test="${not empty o.distanceKm}">Phí ship: ${o.shippingFee}đ · ${o.distanceKm} km · dự kiến ${o.etaMinutes} phút</c:when><c:otherwise>Đơn cũ: chưa có thông tin vận chuyển</c:otherwise></c:choose></div></c:if></td><td><c:choose><c:when test="${o.status eq 'NEW'}">Chờ xác nhận</c:when><c:when test="${o.status eq 'CONFIRMED'}">Đã xác nhận</c:when><c:when test="${o.status eq 'PREPARING'}">Đang chuẩn bị</c:when><c:when test="${o.status eq 'READY'}">Sẵn sàng</c:when><c:when test="${o.status eq 'ASSIGNED'}">Đã phân công giao</c:when><c:when test="${o.status eq 'SHIPPING'}">Đang giao</c:when><c:when test="${o.status eq 'DELIVERED'}">Đã hoàn thành</c:when><c:when test="${o.status eq 'CANCELLED'}">Đã hủy</c:when><c:otherwise><c:out value="${o.status}"/></c:otherwise></c:choose></td><td><c:choose><c:when test="${o.status eq 'NEW'}"><form method="post" action="/my-orders/${o.id}/cancel" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?')"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input class="form-control form-control-sm mb-1" name="reason" maxlength="500" required placeholder="Lý do hủy"><button type="submit" class="btn btn-outline-danger btn-sm">Hủy đơn</button></form></c:when><c:when test="${o.status eq 'CANCELLED'}"><small class="text-muted">Lý do: <c:out value="${o.cancelReason}"/></small></c:when><c:when test="${o.status eq 'DELIVERED'}">
<c:choose><c:when test="${not empty reviewProductsByOrder[o.id]}">
<c:forEach var="p" items="${reviewProductsByOrder[o.id]}">
<a class="btn btn-outline-success btn-sm mb-1" href="${pageContext.request.contextPath}/order/${p.id}#productReviews">Đánh giá: <c:out value="${p.name}"/></a>
</c:forEach>
</c:when><c:otherwise><span class="text-muted small">Không tìm thấy sản phẩm gốc để đánh giá</span></c:otherwise></c:choose>
</c:when><c:otherwise><span class="text-muted small">—</span></c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div><div class="my-3"><a href="/my-returns" class="btn btn-outline-success">Theo dõi trả hàng / hoàn tiền</a></div><h5>Yêu cầu trả hàng (đơn đã giao trong 7 ngày)</h5><c:forEach var="o" items="${orders}"><c:if test="${o.status eq 'DELIVERED'}"><form action="/my-orders/${o.id}/return" method="post" class="card p-2 mb-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><strong>Đơn #${o.id}</strong><textarea class="form-control my-2" name="reason" minlength="10" maxlength="500" placeholder="Lý do trả hàng (10–500 ký tự)" required></textarea><button class="btn btn-outline-danger">Gửi yêu cầu trả hàng</button></form></c:if></c:forEach></main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>
(function(){const status=document.getElementById('orderStatusFilter'),search=document.getElementById('orderSearch'),rows=[...document.querySelectorAll('.order-row')],empty=document.getElementById('ordersNoMatch');
function filter(){const st=status.value,q=search.value.trim().toLocaleLowerCase('vi');let shown=0;rows.forEach(r=>{const match=(!st||r.dataset.status===st)&&(!q||r.dataset.search.toLocaleLowerCase('vi').includes(q));r.hidden=!match;if(match)shown++;});empty.classList.toggle('d-none',shown>0||rows.length===0);}
status.addEventListener('change',filter);search.addEventListener('input',filter);
})();
</script></body></html>
