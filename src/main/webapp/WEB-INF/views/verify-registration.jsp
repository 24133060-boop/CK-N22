<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Xác minh đăng ký - UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="container py-5" style="max-width:520px"><a href="/">← Trang chủ</a><h2 class="mt-3">Xác minh email đăng ký</h2><p>Nhập mã OTP 6 chữ số được gửi tới email. Mã có hiệu lực 10 phút.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><form method="post" action="/verify-registration"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label for="email">Email</label><input class="form-control mb-3" id="email" type="email" name="email" value="<c:out value='${email}'/>" required><label for="otp">Mã OTP</label><input class="form-control mb-3" id="otp" name="otp" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" required><button class="btn btn-primary">Xác minh và tạo tài khoản</button></form><a class="d-block mt-3" href="/register">Đăng ký lại / gửi mã mới</a></main></body></html>
