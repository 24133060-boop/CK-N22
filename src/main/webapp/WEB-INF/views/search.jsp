<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><h1 class="h3 mb-3">Tìm kiếm và lọc sản phẩm</h1>
<form action="/products/search" method="get" class="card p-3 mb-4 shadow-sm">
 <div class="row g-3">
  <div class="col-md-6"><label class="form-label" for="q">Tên sản phẩm</label><input id="q" class="form-control" name="q" value="<c:out value='${q}'/>" placeholder="Nhập tên trà sữa..."></div>
  <div class="col-md-3"><label class="form-label" for="category">Danh mục</label><select id="category" class="form-select" name="category"><option value="">Tất cả danh mục</option><c:forEach var="categ" items="${categories}"><option value="<c:out value='${categ}'/>" ${category eq categ ? 'selected' : ''}><c:out value="${categ}"/></option></c:forEach></select></div>
  <div class="col-md-3"><label class="form-label" for="shopId">Chi nhánh</label><select id="shopId" class="form-select" name="shopId"><option value="">Tất cả chi nhánh</option><c:forEach var="sh" items="${shops}"><option value="${sh.id}" ${shopId eq sh.id ? 'selected' : ''}><c:out value="${sh.name}"/></option></c:forEach></select></div>
  <div class="col-md-3"><label class="form-label" for="minPrice">Giá từ (đ)</label><input id="minPrice" class="form-control" type="number" min="0" step="1000" name="minPrice" value="${minPrice}"></div>
  <div class="col-md-3"><label class="form-label" for="maxPrice">Giá đến (đ)</label><input id="maxPrice" class="form-control" type="number" min="0" step="1000" name="maxPrice" value="${maxPrice}"></div>
  <div class="col-md-3"><label class="form-label" for="sort">Sắp xếp</label><select id="sort" class="form-select" name="sort"><option value="name_asc" ${sort eq 'name_asc' ? 'selected' : ''}>Tên A–Z</option><option value="price_asc" ${sort eq 'price_asc' ? 'selected' : ''}>Giá thấp đến cao</option><option value="price_desc" ${sort eq 'price_desc' ? 'selected' : ''}>Giá cao đến thấp</option><option value="popular_desc" ${sort eq 'popular_desc' ? 'selected' : ''}>Bán chạy nhất</option><option value="rating_desc" ${sort eq 'rating_desc' ? 'selected' : ''}>Đánh giá cao nhất</option><option value="favorites_desc" ${sort eq 'favorites_desc' ? 'selected' : ''}>Yêu thích nhất</option><option value="newest" ${sort eq 'newest' ? 'selected' : ''}>Sản phẩm mới nhất</option></select></div>
  <div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-success flex-grow-1" type="submit">Áp dụng lọc</button><a class="btn btn-outline-secondary" href="/products/search">Xóa lọc</a></div>
 </div>
</form>
<p class="text-muted">Tìm thấy <strong>${total}</strong> sản phẩm · Trang ${page + 1}/${totalPages}</p>
<c:if test="${empty products}"><div class="alert alert-info">Không có sản phẩm phù hợp. Hãy thử thay đổi bộ lọc.</div></c:if>
<div class="row g-3">
<c:forEach var="p" items="${products}"><div class="col-sm-6 col-lg-4"><div class="card h-100 shadow-sm overflow-hidden">
<c:choose><c:when test="${not empty p.imageUrl}"><img src="<c:out value='${p.imageUrl}'/>" class="card-img-top" alt="<c:out value='${p.name}'/>" style="height:190px;object-fit:cover" onerror="this.style.display='none'"></c:when><c:otherwise><div class="text-center p-4" style="font-size:3rem">🧋</div></c:otherwise></c:choose>
<div class="card-body"><div class="small text-muted"><c:out value="${p.category}"/> · <c:out value="${p.shop.name}"/></div><h5 class="card-title"><c:out value="${p.name}"/></h5><p class="fw-bold text-success"><fmt:formatNumber value="${p.price}" maxFractionDigits="0" groupingUsed="true"/> đ</p><a class="btn btn-outline-success" href="/order/${p.id}">Xem sản phẩm</a></div></div></div></c:forEach>
</div>
<c:if test="${totalPages gt 1}"><nav class="mt-4" aria-label="Phân trang"><ul class="pagination flex-wrap">
<c:forEach begin="0" end="${totalPages - 1}" var="i"><c:url var="pageUrl" value="/products/search"><c:param name="q" value="${q}"/><c:param name="category" value="${category}"/><c:param name="shopId" value="${shopId}"/><c:param name="minPrice" value="${minPrice}"/><c:param name="maxPrice" value="${maxPrice}"/><c:param name="sort" value="${sort}"/><c:param name="page" value="${i}"/></c:url><li class="page-item ${page eq i ? 'active' : ''}"><a class="page-link" href="${pageUrl}">${i + 1}</a></li></c:forEach>
</ul></nav></c:if>
</main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
