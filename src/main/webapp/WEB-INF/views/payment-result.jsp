<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Kết quả VNPay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="container py-5"><h2>Kết quả thanh toán VNPay</h2><c:choose><c:when test="${not verified}"><div class="alert alert-danger">Chữ ký giao dịch không hợp lệ.</div></c:when><c:when test="${success}"><div class="alert alert-info">VNPay báo giao dịch thành công. Hệ thống chỉ ghi nhận ĐÃ THANH TOÁN khi nhận được IPN hợp lệ từ VNPay.</div></c:when><c:otherwise><div class="alert alert-warning">Thanh toán chưa thành công hoặc đã hủy.</div></c:otherwise></c:choose><p>Mã tham chiếu: <c:out value="${transaction}"/></p><a href="/my-orders">Xem đơn hàng</a></body></html>