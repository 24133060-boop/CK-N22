<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><h2>Tổng quan hệ thống</h2><a href="/manager/catalog" class="btn btn-success mb-3">Quản lý chi nhánh, sản phẩm, danh mục & khuyến mãi</a><div class="card p-3 my-3"><h5>Đối soát chuyển khoản VietQR</h5><p class="small text-muted">Chỉ xác nhận khi tiền thực sự vào tài khoản ngân hàng.</p><c:forEach var="o" items="${orders}"><c:if test="${o.payment eq 'VIETQR' and o.paymentStatus eq 'UNPAID' and o.status ne 'CANCELLED'}"><div class="d-flex align-items-center gap-3 border-bottom py-2"><span>Đơn #${o.id} — ${o.total}đ — <c:out value="${o.shop.name}"/></span><form method="post" action="/manager/orders/${o.id}/confirm-vietqr" onsubmit="return confirm('Đã đối chiếu sao kê và nhận đủ tiền?')"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-success">Xác nhận nhận tiền</button></form></div></c:if></c:forEach></div><sec:authorize access="hasRole('ADMIN')"><a href="/manager/vouchers" class="btn btn-outline-success mb-3">Quản lý voucher toàn hệ thống</a></sec:authorize><div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3"><div class="text-muted">Chi nhánh</div><h3>${shops.size()}</h3></div></div><div class="col-md-4"><div class="card p-3"><div class="text-muted">Sản phẩm</div><h3>${products.size()}</h3></div></div><div class="col-md-4"><div class="card p-3"><div class="text-muted">Tổng số đơn</div><h3>${orders.size()}</h3></div></div></div><div class="row g-3 mb-4"><div class="col-md-6"><div class="card p-3"><div class="text-muted">Đơn hoàn thành</div><h3>${deliveredOrders.size()}</h3></div></div><div class="col-md-6"><div class="card p-3"><div class="text-muted">Doanh thu món từ đơn hoàn thành (không gồm phí giao hàng)</div><h3>${revenue}đ</h3></div></div></div><h4>Danh sách chi nhánh</h4><div class="row g-3 mb-4"><c:forEach var="s" items="${shops}"><div class="col-md-4"><div class="card p-3"><h5><c:out value="${s.name}"/></h5><p><c:out value="${s.address}"/></p></div></div></c:forEach></div><sec:authorize access="hasRole('ADMIN')"><h4>Quản lý vai trò tài khoản</h4><p class="text-muted small">Thay đổi vai trò có hiệu lực sau khi tài khoản đăng nhập lại. Không thể tự đổi vai trò của mình.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Email</th><th>Họ tên</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="u" items="${users}"><tr><td><c:out value="${u.email}"/></td><td><c:out value="${u.displayName}"/></td><td>${u.role}</td><td><form method="post" action="/admin/users/${u.id}/role" class="d-flex gap-2" onsubmit="return confirm('Xác nhận thay đổi vai trò?')"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><select class="form-select form-select-sm" name="role"><option value="USER" ${u.role eq 'USER' ? 'selected' : ''}>USER</option><option value="VENDOR" ${u.role eq 'VENDOR' ? 'selected' : ''}>VENDOR</option><option value="MANAGER" ${u.role eq 'MANAGER' ? 'selected' : ''}>MANAGER</option><option value="ADMIN" ${u.role eq 'ADMIN' ? 'selected' : ''}>ADMIN</option><option value="SHIPPER" ${u.role eq 'SHIPPER' ? 'selected' : ''}>SHIPPER</option></select><button class="btn btn-sm btn-outline-primary">Lưu</button></form></td></tr></c:forEach></tbody></table></div></sec:authorize><sec:authorize access="hasRole('ADMIN')"><div class="d-flex gap-2 my-3"><a href="/admin/applications" class="btn btn-outline-success">Duyệt đăng ký shop</a><a href="/admin/settings" class="btn btn-outline-success">Chiết khấu & đơn vị vận chuyển</a></div></sec:authorize><sec:authorize access="hasRole('ADMIN')"><h4 class="mt-4">Quản lý trạng thái cửa hàng</h4><c:forEach var="sh" items="${shops}"><form method="post" action="/admin/shops/${sh.id}/toggle" class="card p-2 mb-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><span><c:out value="${sh.name}"/> · ${sh.active ? 'Đang hoạt động' : 'Tạm khóa'}</span><button class="btn btn-sm btn-outline-warning">Bật / tắt cửa hàng</button></form></c:forEach></sec:authorize></main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
