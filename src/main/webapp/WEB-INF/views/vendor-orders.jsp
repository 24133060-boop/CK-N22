<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><h2>Đơn hàng — <c:out value="${shop.name}"/></h2><a href="/vendor" class="btn btn-outline-secondary btn-sm mb-3">← Cửa hàng của tôi</a>
<div class="card p-3 mb-3"><h5>Giờ nhận đơn</h5><form method="post" action="/vendor/shop/${shop.id}/hours" class="row g-2 align-items-end"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="col-md-3"><label>Mở cửa</label><input type="time" class="form-control" name="opensAt" value="${shop.opensAt}" required></div><div class="col-md-3"><label>Đóng cửa</label><input type="time" class="form-control" name="closesAt" value="${shop.closesAt}" required></div><div class="col-md-3"><button class="btn btn-outline-success">Cập nhật giờ</button></div></form><small class="text-muted">Nếu giờ mở bằng giờ đóng: nhận đơn cả ngày.</small></div>
<div class="card p-3 mb-3"><h5>Trạng thái món</h5><div class="row g-2"><c:forEach var="p" items="${allProducts}"><div class="col-md-4"><form method="post" action="/vendor/products/${p.id}/availability" class="d-flex align-items-center justify-content-between border rounded p-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><span><c:out value="${p.name}"/></span><button class="btn btn-sm ${p.available ? 'btn-outline-success' : 'btn-outline-danger'}">${p.available ? 'Đang bán' : 'Hết món'}</button></form></div></c:forEach></div></div>
<div class="alert alert-success">Doanh thu tiền món của đơn đã hoàn thành: <strong>${shopRevenue}đ</strong> · Số đơn hoàn thành: <strong>${deliveredCount}</strong></div><h4>Quản lý đơn</h4><section class="card p-3 my-3"><h5>Chỉnh sửa sản phẩm của chi nhánh</h5><p class="text-muted small">Thay đổi tên, danh mục, giá bán. Trạng thái còn/hết hàng vẫn dùng chức năng hiện có.</p><c:if test="${empty allProducts}"><p>Chưa có sản phẩm.</p></c:if><c:forEach var="p" items="${allProducts}"><form method="post" action="/vendor/products/${p.id}/edit" class="row g-2 align-items-end border-bottom py-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="col-md-4"><label class="form-label small">Tên món #${p.id}</label><input class="form-control form-control-sm" name="name" value="<c:out value='${p.name}'/>" maxlength="255" required></div><div class="col-md-3"><label class="form-label small">Danh mục</label><input class="form-control form-control-sm" name="category" value="<c:out value='${p.category}'/>" maxlength="255" required></div><div class="col-md-3"><label class="form-label small">Giá (đ)</label><input class="form-control form-control-sm" name="price" type="number" min="1" max="10000000" step="1" value="<fmt:formatNumber value='${p.price}' pattern='0' groupingUsed='false'/>" required></div><div class="col-md-2"><button class="btn btn-sm btn-outline-success w-100">Lưu món</button></div></form></c:forEach></section>
<section class="card p-3 mb-3"><h5>Ảnh sản phẩm (Cloudinary)</h5><c:forEach var="p" items="${allProducts}"><form action="/vendor/products/${p.id}/image" method="post" enctype="multipart/form-data" class="row g-2 align-items-center border-bottom py-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="col-md-4"><c:out value="${p.name}"/></div><div class="col-md-5"><input type="file" class="form-control form-control-sm" name="image" accept="image/jpeg,image/png,image/webp" required></div><div class="col-md-3"><button class="btn btn-sm btn-outline-success">Tải ảnh</button></div></form></c:forEach></section>
<div class="alert alert-info" id="liveNotice" role="status">Thông báo đơn hàng sẽ tự cập nhật khi có thay đổi.</div>
<script src="https://cdn.jsdelivr.net/npm/@stomp/stompjs@7/bundles/stomp.umd.min.js"></script>
<script>document.addEventListener('DOMContentLoaded',function(){if(!window.StompJs)return;let client=new StompJs.Client({brokerURL:(location.protocol==='https:'?'wss':'ws')+'://'+location.host+'/ws-updates',reconnectDelay:5000});client.onConnect=()=>client.subscribe('/topic/order-updates',()=>{let e=document.getElementById('liveNotice');e.textContent='Có thay đổi đơn hàng. Hãy tải lại trang để xem dữ liệu mới.';e.className='alert alert-warning'});client.activate()});</script>
<div class="row g-2 mb-3"><div class="col-md-4"><input id="orderQuery" class="form-control" placeholder="Tìm mã đơn hoặc tên món" oninput="filterVendor()"></div><div class="col-md-4"><select id="orderStatus" class="form-select" onchange="filterVendor()"><option value="">Tất cả trạng thái</option><option value="NEW">Mới</option><option value="CONFIRMED">Đã xác nhận</option><option value="PREPARING">Đang chuẩn bị</option><option value="READY">Sẵn sàng</option><option value="ASSIGNED">Đã phân công</option><option value="SHIPPING">Đang giao</option><option value="DELIVERED">Hoàn tất</option><option value="CANCELLED">Đã hủy</option></select></div><div class="col-md-4"><input type="date" id="orderDate" class="form-control" onchange="filterVendor()"></div></div>
<c:if test="${empty orders}"><div class="alert alert-info">Hiện chưa có đơn hàng tại cửa hàng này.</div></c:if><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã</th><th>Món</th><th>Ngày</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr class="order-row" data-id="${o.id}" data-name="${o.productName}" data-status="${o.status}" data-date="${o.createdAt.toLocalDate()}"><td>#${o.id}</td><td><c:out value="${o.productName}"/><c:if test="${not empty o.lines}"><details class="small mt-1"><summary>Chi tiết ${o.lines.size()} món</summary><c:forEach var="line" items="${o.lines}"><div><c:out value="${line.productName}"/> × ${line.quantity} — <c:out value="${line.size}"/> / <c:out value="${line.sugar}"/> / <c:out value="${line.ice}"/> / <c:out value="${line.topping}"/></div></c:forEach></details></c:if></td><td>${o.createdAt.toLocalDate()}<div class="small mt-1">Thanh toán: <c:out value="${o.payment}"/> / <c:out value="${o.paymentStatus}"/></div><c:if test="${o.payment eq 'VIETQR' and o.paymentStatus eq 'UNPAID' and o.status ne 'CANCELLED'}"><form method="post" action="/vendor/orders/${o.id}/confirm-vietqr" onsubmit="return confirm('Đã kiểm tra sao kê ngân hàng và nhận đủ tiền cho đơn này?')"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-success mt-1" type="submit">Xác nhận đã nhận tiền</button></form></c:if></td><td><c:choose><c:when test="${o.status eq 'DELIVERED'}"><span class="badge text-bg-success">Đã hoàn tất</span></c:when><c:when test="${o.status eq 'CANCELLED'}"><span class="badge text-bg-danger">Đã hủy</span></c:when><c:otherwise><span class="badge text-bg-secondary">${o.status}</span></c:otherwise></c:choose></td><td><c:choose>
<c:when test="${o.status eq 'NEW' or o.status eq 'CONFIRMED' or o.status eq 'PREPARING' or (o.status eq 'READY' and o.fulfillment eq 'PICKUP')}"><form method="post" action="/vendor/orders/${o.id}/status" class="d-flex flex-wrap gap-2" onsubmit="return confirmVendor(this)"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><select class="form-select form-select-sm" name="status" onchange="toggleReason(this)"><c:if test="${o.status eq 'NEW'}"><option value="CONFIRMED">Xác nhận đơn</option><option value="CANCELLED">Hủy đơn</option></c:if><c:if test="${o.status eq 'CONFIRMED'}"><option value="PREPARING">Bắt đầu chuẩn bị</option><option value="CANCELLED">Hủy đơn</option></c:if><c:if test="${o.status eq 'PREPARING'}"><option value="READY">Đã chuẩn bị xong</option></c:if><c:if test="${o.status eq 'READY' and o.fulfillment eq 'PICKUP'}"><option value="DELIVERED">Đã bàn giao tại quầy</option></c:if></select><input class="form-control form-control-sm cancel-reason" name="reason" placeholder="Lý do hủy" style="display:none;max-width:180px"><button class="btn btn-sm btn-primary">Lưu</button></form></c:when>
<c:when test="${o.status eq 'READY' and o.fulfillment eq 'DELIVERY'}"><c:choose><c:when test="${empty shippers}"><span class="text-warning">Chưa có tài khoản Shipper</span></c:when><c:otherwise><form method="post" action="/vendor/orders/${o.id}/assign" class="d-flex gap-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><select name="shipperEmail" class="form-select form-select-sm"><c:forEach var="sh" items="${shippers}"><option value="${sh.email}"><c:out value="${sh.displayName}"/></option></c:forEach></select><button class="btn btn-sm btn-success">Phân công</button></form></c:otherwise></c:choose></c:when>
<c:when test="${o.status eq 'DELIVERED'}"><span class="text-success">✓ Đã hoàn tất</span></c:when><c:when test="${o.status eq 'CANCELLED'}"><span class="text-muted">Lý do: <c:out value="${o.cancelReason}"/></span></c:when><c:when test="${o.status eq 'SHIPPING'}">Shipper đang giao hàng</c:when><c:when test="${o.status eq 'ASSIGNED'}">Đã phân công: <c:out value="${o.shipperEmail}"/></c:when><c:otherwise><span class="text-muted">Không có thao tác tiếp theo</span></c:otherwise></c:choose></td></tr></c:forEach></tbody></table><div id="noFilteredOrders" class="alert alert-info" style="display:none">Không tìm thấy đơn phù hợp với bộ lọc.</div></div>
<script>function toggleReason(sel){let x=sel.form.querySelector('.cancel-reason');x.style.display=sel.value==='CANCELLED'?'block':'none';x.required=sel.value==='CANCELLED'}function confirmVendor(form){let v=form.querySelector('[name=status]').value;if(v==='CANCELLED')return confirm('Bạn chắc chắn muốn hủy đơn này?');if(v==='DELIVERED')return confirm('Xác nhận đã bàn giao đơn tại quầy?');return true}function filterVendor(){let q=document.getElementById('orderQuery').value.toLowerCase(),st=document.getElementById('orderStatus').value,dt=document.getElementById('orderDate').value,n=0;document.querySelectorAll('.order-row').forEach(r=>{let ok=(!q||('#'+r.dataset.id+' '+r.dataset.name).toLowerCase().includes(q))&&(!st||r.dataset.status===st)&&(!dt||r.dataset.date===dt);r.style.display=ok?'':'none';if(ok)n++});document.getElementById('noFilteredOrders').style.display=n?'none':'block'}</script><div class="my-3 d-flex gap-2"><a class="btn btn-outline-success" href="/vendor/shop/${shop.id}/returns">Yêu cầu trả hàng</a><a class="btn btn-outline-success" href="/vendor/shop/${shop.id}/promotions">Khuyến mãi của shop</a></div><div class="card p-3 my-3"><h5>Thêm món mới</h5><form method="post" action="/vendor/shop/${shop.id}/products"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input name="name" class="form-control mb-2" maxlength="255" placeholder="Tên món" required><input name="category" class="form-control mb-2" maxlength="255" placeholder="Danh mục" required><input type="number" name="price" min="1000" max="10000000" step="1" class="form-control mb-2" placeholder="Giá size S (đ)" required><button class="btn btn-success">Thêm sản phẩm</button></form></div><script>
/* Keep the vendor at the order being handled after a normal POST/Redirect/GET. */
(function () {
  const storageKey = 'utemilktea:vendor-order-position:' + location.pathname;
  const table = document.querySelector('.table-responsive table');
  if (!table) return;

  function orderFilters() {
    return {
      q: document.getElementById('orderQuery').value,
      status: document.getElementById('orderStatus').value,
      date: document.getElementById('orderDate').value
    };
  }

  // Capture orders form submissions, including payment confirmation and shipper assignment.
  table.addEventListener('submit', function (event) {
    const form = event.target;
    if (!form.matches('form')) return;
    const row = form.closest('tr.order-row');
    if (!row) return;
    try {
      sessionStorage.setItem(storageKey, JSON.stringify({
        orderId: row.dataset.id,
        scrollY: window.scrollY,
        filters: orderFilters(),
        savedAt: Date.now()
      }));
    } catch (e) { /* Storage can be disabled; submitting the order still works. */ }
  });

  let saved;
  try {
    const raw = sessionStorage.getItem(storageKey);
    sessionStorage.removeItem(storageKey);
    if (raw) saved = JSON.parse(raw);
  } catch (e) { return; }
  if (!saved || Date.now() - saved.savedAt > 120000) return;

  if (saved.filters) {
    document.getElementById('orderQuery').value = saved.filters.q || '';
    document.getElementById('orderStatus').value = saved.filters.status || '';
    document.getElementById('orderDate').value = saved.filters.date || '';
    filterVendor();
  }

  // Wait for layout, then put the same order back in view even if rows above changed.
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      const row = Array.from(document.querySelectorAll('tr.order-row'))
        .find(function (el) { return el.dataset.id === String(saved.orderId); });
      if (row && row.style.display !== 'none') {
        row.scrollIntoView({block:'center', behavior:'instant'});
        row.classList.add('table-success');
      } else if (Number.isFinite(saved.scrollY)) {
        window.scrollTo({top:saved.scrollY, behavior:'instant'});
      }
    });
  });
})();
</script>
</main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
