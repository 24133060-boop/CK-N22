<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UTEMILKTEA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg"><div class="container"><a class="navbar-brand" href="/">🍵 UTEMILKTEA</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"><a class="nav-link" href="/">Trang chủ</a><a class="nav-link" href="/#stores">Chi nhánh</a><a class="nav-link" href="/#menu">Menu</a><sec:authorize access="isAuthenticated()"><sec:authorize access="hasRole('USER')"><a class="nav-link" href="/cart">Giỏ hàng</a><a class="nav-link" href="/my-orders">Đơn hàng</a><a class="nav-link" href="/favorites">Yêu thích</a></sec:authorize><sec:authorize access="hasRole('VENDOR')"><a class="nav-link" href="/vendor">Cửa hàng của tôi</a></sec:authorize><sec:authorize access="hasRole('MANAGER')"><a class="nav-link" href="/manager">Manager</a></sec:authorize><sec:authorize access="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></sec:authorize><sec:authorize access="hasRole('SHIPPER')"><a class="nav-link" href="/shipper">Giao hàng</a></sec:authorize><div class="dropdown ms-lg-2"><button class="btn btn-outline-success dropdown-toggle rounded-pill" data-bs-toggle="dropdown" type="button">👤 <sec:authentication property="name"/></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/profile">Hồ sơ cá nhân</a></li><sec:authorize access="hasRole('USER')"><li><a class="dropdown-item" href="/my-orders">Đơn hàng của tôi</a></li></sec:authorize><li><hr class="dropdown-divider"></li><li><form method="post" action="/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="dropdown-item text-danger" type="submit">Đăng xuất</button></form></li></ul></div></sec:authorize><sec:authorize access="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a><a class="btn btn-primary ms-lg-2" href="/register">Đăng ký</a></sec:authorize></div></div></div></nav><main class="container py-4"><div class="mb-3"><a class="text-decoration-none small text-success" href="javascript:history.back()" onclick="if(history.length<2){this.href='/'}">← Quay lại</a> <span class="text-muted mx-2">/</span><a class="small text-muted" href="/">Trang chủ</a></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if><h2>Đơn giao hàng của tôi</h2><div class="alert alert-info">Tổng đơn được phân công: <strong>${shipperTotal}</strong> · Đã giao: <strong>${shipperDelivered}</strong> · Đang giao: <strong>${shipperActive}</strong></div><p class="text-muted">Chỉ hiển thị đơn được phân công cho tài khoản hiện tại.</p><div class="mb-3"><button class="btn btn-outline-success me-2" onclick="shipTab('active')">Đang thực hiện</button><button class="btn btn-outline-secondary" onclick="shipTab('history')">Lịch sử giao hàng</button></div><c:if test="${empty orders}"><div class="alert alert-info">Bạn chưa được phân công đơn hàng nào.</div></c:if><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Đơn / điểm lấy</th><th>Điểm giao</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr class="ship-row" data-done="${o.status eq 'DELIVERED' or o.status eq 'CANCELLED'}"><td><strong>#${o.id}</strong><div class="small mt-1">Cửa hàng: <c:out value="${o.shop.name}"/></div><div class="small text-muted"><c:out value="${o.shop.address}"/></div><c:if test="${not empty o.lines}"><details class="small mt-1"><summary>${o.lines.size()} món</summary><c:forEach var="line" items="${o.lines}"><div><c:out value="${line.productName}"/> × ${line.quantity} · <c:out value="${line.size}"/> · <c:out value="${line.topping}"/></div></c:forEach></details></c:if></td><td><c:out value="${o.address}"/><c:if test="${not empty o.deliveryLatitude and not empty o.deliveryLongitude}"><div class="mt-1"><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps?q=${o.deliveryLatitude},${o.deliveryLongitude}">Mở vị trí trên bản đồ</a></div></c:if><c:if test="${not empty o.distanceKm}"><div class="small text-muted mt-1">${o.distanceKm} km · dự kiến ${o.etaMinutes} phút</div></c:if></td><td><c:choose><c:when test="${o.status eq 'DELIVERED'}"><span class="badge text-bg-success">Đã giao thành công</span><div class="small text-muted">${o.deliveredAt}</div></c:when><c:when test="${o.status eq 'ASSIGNED'}"><span class="badge text-bg-warning">Chờ lấy hàng</span></c:when><c:when test="${o.status eq 'SHIPPING'}"><span class="badge text-bg-primary">Đang giao hàng</span></c:when><c:otherwise>${o.status}</c:otherwise></c:choose></td><td><c:choose><c:when test="${o.status eq 'ASSIGNED' or o.status eq 'SHIPPING'}"><form method="post" action="/shipper/orders/${o.id}/status" onsubmit="return this.querySelector('[name=status]').value!=='DELIVERED'||confirm('Xác nhận đã giao hàng thành công?')"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:choose><c:when test="${o.status eq 'ASSIGNED'}"><input type="hidden" name="status" value="SHIPPING"><button class="btn btn-sm btn-primary">Xác nhận đã lấy hàng</button></c:when><c:otherwise><input type="hidden" name="status" value="DELIVERED"><button class="btn btn-sm btn-success">Giao thành công</button></c:otherwise></c:choose></form></c:when><c:when test="${o.status eq 'DELIVERED'}"><span class="text-success">✓ Đã hoàn tất</span></c:when><c:otherwise><span class="text-muted">Không có thao tác</span></c:otherwise></c:choose></td></tr></c:forEach></tbody></table><div id="shipEmpty" class="alert alert-info" style="display:none">Không có đơn trong mục này.</div></div><script>function shipTab(which){let n=0;document.querySelectorAll('.ship-row').forEach(r=>{let ok=(r.dataset.done==='true')===(which==='history');r.style.display=ok?'':'none';if(ok)n++});document.getElementById('shipEmpty').style.display=n?'none':'block'}shipTab('active')</script></main><footer class="footer"><div class="container">UTEMILKTEA · Trà sữa mỗi ngày, niềm vui mỗi ngụm · Dự án học tập</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
