<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Chi tiết đơn #${order.id}</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4"><a href="/my-orders">← Đơn hàng của tôi</a><h2>Chi tiết đơn #${order.id}</h2><div class="card p-4"><p>Chi nhánh: <strong><c:out value="${order.shop.name}"/></strong></p><p>Trạng thái: <c:out value="${order.status}"/></p><p>Nhận hàng: ${order.fulfillment eq 'PICKUP' ? 'Tại cửa hàng' : 'Giao tận nơi'}</p><c:if test="${order.fulfillment eq 'DELIVERY'}"><p>Địa chỉ: <c:out value="${order.address}"/></p><p>Quãng đường: ${order.distanceKm} km · Dự kiến: ${order.etaMinutes} phút</p></c:if><hr><h5>Các món</h5><c:choose><c:when test="${not empty order.lines}"><c:forEach var="l" items="${order.lines}"><p><c:out value="${l.productName}"/> × ${l.quantity} — ${l.subtotal}đ<br><small>Size: <c:out value="${l.size}"/> · Đường: <c:out value="${l.sugar}"/> · Đá: <c:out value="${l.ice}"/> · Topping: <c:out value="${l.topping}"/></small></p></c:forEach></c:when><c:otherwise><p><c:out value="${order.productName}"/> × ${order.quantity}</p></c:otherwise></c:choose><hr><p>Phí giao hàng: ${order.shippingFee}đ · Giảm phí: ${order.shippingDiscountAmount}đ</p><p>Khuyến mãi cửa hàng: <c:out value="${order.appliedShopPromotion}"/> · Giảm: ${order.shopPromotionDiscount}đ</p><p>Voucher: <c:out value="${order.voucherCode}"/> · Tổng giảm: ${order.discountAmount}đ</p><h4>Tổng thanh toán: ${order.total}đ</h4><p>Thanh toán: <c:out value="${order.payment}"/> — <c:out value="${order.paymentStatus}"/></p><c:if test="${order.payment eq 'VIETQR'}"><a class="btn btn-success" href="/payment/vietqr/${order.id}">Xem mã VietQR / trạng thái thanh toán</a></c:if></div></main></body></html>